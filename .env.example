# Never put this key in frontend code or commit your .env file.
FMP_API_KEY=
# Match your provider plan's request limit (the default below is conservative).
FMP_REQUESTS_PER_MINUTE=120
INDEXLENS_REPORT=web/data/report.json
# Comma-separated frontend origins only if the API is hosted separately.
CORS_ORIGINS=http://localhost:8000

